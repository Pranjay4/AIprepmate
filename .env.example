# CampusPrep works with no environment variables at all: it then runs in demo mode
# (accounts and progress in the browser's localStorage, rule-based feedback only).
# Copy this file to .env.local and fill in only what you need. Never commit .env.local.

# ── Optional: AI feedback ────────────────────────────────────────────────────
# Enables "Additional AI feedback" on mock-interview scorecards and the AI
# participants in the GD Simulator. Keys are read server-side only.
# Which provider to use: "anthropic" | "openai" | "gemini"
AI_PROVIDER=anthropic

# Only the key for the selected provider is required.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ── Optional: Supabase (not wired yet — see README "Moving to Supabase") ─────
# The schema in supabase/schema.sql is ready to apply. The app keeps using the
# local demo repository until a Supabase implementation of the Repository
# interface (lib/cp/data/repository.ts) is added.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
